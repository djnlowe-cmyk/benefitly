# Required for any deployment (Vercel, local, CI)

# Database — currently SQLite for local dev (file:./dev.db).
# For Vercel/production, switch the Prisma datasource to "postgresql"
# and set this to a hosted Postgres connection string (Vercel Postgres,
# Neon, Supabase, etc.). SQLite cannot run on Vercel because the
# filesystem is read-only at runtime.
DATABASE_URL="file:./dev.db"

# NextAuth v5 secret. Required in production. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# NextAuth canonical URL. Vercel sets VERCEL_URL automatically; this is
# only needed for non-Vercel hosts or custom domains.
# NEXTAUTH_URL="https://your-deployment.vercel.app"

# Anthropic API key for /api/upload AI document extraction.
# Without this, uploads still succeed but the parsed-data step is skipped.
ANTHROPIC_API_KEY=""
