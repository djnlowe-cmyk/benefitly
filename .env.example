# Required for any deployment (Vercel, local, CI).
# Validated at boot by src/lib/env.ts — missing required vars throw on the
# first import of src/lib/db.ts.

# Postgres connection string. Use a hosted Postgres (Neon is the deployment
# target) for production. For local dev you can run Postgres in Docker:
#   docker run -d --name benefitly-pg -p 5432:5432 \
#     -e POSTGRES_PASSWORD=benefitly postgres:16
# DATABASE_URL="postgresql://postgres:benefitly@localhost:5432/benefitly"
DATABASE_URL=""

# NextAuth v5 secret. Required. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# NextAuth canonical URL. Vercel sets VERCEL_URL automatically; this is
# only needed for non-Vercel hosts or custom domains.
# NEXTAUTH_URL="https://your-deployment.vercel.app"

# Vercel Blob token for document uploads. When unset, the upload route falls
# back to writing under ./uploads/ on local disk (dev only — Vercel's runtime
# filesystem is read-only outside /tmp). Provision via the Vercel dashboard:
#   Storage → Blob → Connect to project.
BLOB_READ_WRITE_TOKEN=""

# Anthropic API key for /api/upload AI document extraction.
# Optional. Without it, uploads still succeed but the parsed-data step is skipped.
ANTHROPIC_API_KEY=""

# Comma-separated list of admin email addresses. Required for any account
# that should be able to view /admin/metrics/gaps. Non-admin authed users
# get a 404 (the admin surface is intentionally invisible).
ADMIN_USER_EMAILS=""
