generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  country         String    @default("GB")
  currency        String    @default("GBP")
  onboardingState String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coverages         Coverage[]
  alerts            Alert[]
  transactions      Transaction[]
  assets            Asset[]
  claims            Claim[]
  familyMembers     FamilyMember[]
  documents         Document[]
  conciergeQueries  ConciergeQuery[]
  searchEvents      SearchEvent[]
  claudeUsage       ClaudeUsage[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  name      String
  relation  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Coverage {
  id            String   @id @default(cuid())
  provider      String
  type          String
  category      String
  policyNo      String?
  status        String   @default("active")
  statusLabel   String   @default("Active")
  covered       String
  startDate     String
  endDate       String
  premium       Float    @default(0)
  deductible    Float?
  oopMax        Float?
  coverageLimit String?
  coInsurance   String?
  exclusions    String   @default("[]")
  claimPhone    String?
  claimUrl      String?
  summary       String?
  confidence    Float?

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id])

  alerts        Alert[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
}

model Alert {
  id         String   @id @default(cuid())
  type       String
  severity   String
  title      String
  detail     String
  date       String
  read       Boolean  @default(false)

  coverageId String?
  coverage   Coverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([read])
}

model Transaction {
  id             String  @id @default(cuid())
  date           String
  merchant       String
  amount         Float
  card           String
  cardType       String
  category       String
  coverageStatus String
  benefits       String  @default("[]")
  missedOpp      String?

  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Asset {
  id              String  @id @default(cuid())
  name            String
  category        String
  value           Float
  purchaseDate    String
  photos          Int     @default(0)
  lastPhotoUpdate String?
  coverages       String  @default("[]")
  riskLevel       String  @default("low")
  riskNote        String?

  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Claim {
  id         String  @id @default(cuid())
  incident   String
  date       String
  provider   String
  category   String
  status     String  @default("not_started")
  step       Int     @default(0)
  totalSteps Int     @default(5)
  steps      String  @default("[]")
  nextAction String?
  deadline   String?

  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Document {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  storagePath  String
  parsedData   String?
  confidence   Float?

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverages    Coverage[]
  claudeUsage  ClaudeUsage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// Per-call instrumentation for /api/search. Drives the retention-monetisation
// leading indicators (TTFV, activation rate, search-issued rate). Additive —
// fire-and-forget on the request path so a write failure never fails search.
model SearchEvent {
  id           String   @id @default(cuid())
  userId       String
  query        String
  resultCount  Int
  successful   Boolean
  costPence    Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Captures user-submitted "we couldn't answer this" feedback from the search
// view. v1 is DB-only — CPO reads the table directly. We persist what the user
// asked + what they expected so we can triage gaps without a chat thread.
model ConciergeQuery {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query          String
  expectedAnswer String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// Per-Claude-call instrumentation. Drives the AI cost & quality dashboard
// (per-doc + per-user £-spend, weekly digest, £1.10 trip-wire). We only
// persist non-sensitive metadata: token counts, model, task, costs. Never
// the prompt body or the response text — see security-compliance §2.
model ClaudeUsage {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId           String?
  document             Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  task                 String
  model                String
  inputTokens          Int       @default(0)
  outputTokens         Int       @default(0)
  cacheReadTokens      Int       @default(0)
  cacheCreationTokens  Int       @default(0)
  costPence            Int       @default(0)
  successful           Boolean   @default(true)
  createdAt            DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([documentId])
  @@index([task, createdAt])
}
